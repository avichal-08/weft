# copy to .env next to this file on the server (chmod 600); docker compose reads it for interpolation
WEFT_DOMAIN=weft.example.com
WEFT_IMAGE=ghcr.io/avichal-08/weft
WEFT_TAG=latest
SANDBOX_IMAGE=ghcr.io/avichal-08/weft-sandbox:latest

# getent group docker | cut -d: -f3
DOCKER_GID=

# sign-in: pnpm --filter @weft/web auth:hash, and openssl rand -base64 32
WEFT_PASSWORD_HASH=
SESSION_SECRET=

# neon, pooled
DATABASE_URL=

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# publishing; the key file must be readable by uid 1000 (chown 1000 github-app.pem; chmod 400)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=./github-app.pem

WORKER_CONCURRENCY=2
SESSION_SANDBOXES_MAX=2
TOKEN_BUDGET=500000
