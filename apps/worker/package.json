  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^22.20.5",
    "@weft/eslint-config": "workspace:*",
    "@weft/tsconfig": "workspace:*",
    "dockerode": "^5.0.1",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
