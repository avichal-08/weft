{
  "name": "weft",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/compose.yml down",
    "sandbox:build": "docker build -t weft-sandbox:dev infra/sandbox",
    "sandbox:smoke": "sh infra/sandbox/smoke.sh",
    "db:generate": "pnpm --filter @weft/db db:generate",
    "db:migrate": "pnpm --filter @weft/db db:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
